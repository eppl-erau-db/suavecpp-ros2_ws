<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>suave_launch</name>
  <version>0.1.0</version>
  <description>SUAVE offboard flight control: PX4 over MAVSDK, with RealSense + RTAB-Map visual-inertial odometry</description>
  <maintainer email="kennedp8@my.erau.edu">suave</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- MAVSDK has no rosdep key; it is installed from setup/libmavsdk-dev_*.deb -->
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>ament_index_cpp</depend>

  <!-- VIO stack started by suave_main on the real drone (launch/suave_slam.py) -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
