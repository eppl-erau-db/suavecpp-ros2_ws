{
  "configurations": [
    {
      "name": "ROS",
      "includePath": [
        "${workspaceFolder}/src/suave_launch/src/**",
        "/opt/ros/humble/include/**",
        "/usr/include/mavsdk/**",
        "/usr/local/include/mavsdk/**",
        "/usr/include/**"
      ],
      "browse": {
        "databaseFilename": "${default}",
        "limitSymbolsToIncludedHeaders": false
      },
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
